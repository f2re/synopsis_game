{
  "schema": "hub-ui-sprites/v2",
  "scene": "hub",
  "atlas": {
    "image": "assets/generated/hub/ui/hub_ui_atlas_v1.png",
    "metadata": "assets/generated/hub/ui/hub_ui_atlas_v1.json",
    "size": [1024, 512],
    "pixelScale": 4,
    "frameCount": 30
  },
  "policy": {
    "textBakedIntoSprites": false,
    "allUiExcludedFromWorldLighting": true,
    "panelsUseNineSlice": true,
    "iconsUseIndependentSpriteFrames": true,
    "semanticIdsRemainStable": true,
    "cssMayPositionButMustNotRedrawProductionChrome": true,
    "phaserGraphicsMayNotReplaceProductionUiArt": true
  },
  "families": {
    "chrome": [
      "hub_ui_top_status_frame",
      "hub_ui_avatar_frame",
      "hub_ui_status_chip",
      "hub_ui_location_label_frame",
      "hub_ui_bottom_nav_slot",
      "hub_ui_primary_cta_frame",
      "hub_ui_secondary_button_frame",
      "hub_ui_notification_frame",
      "hub_ui_progress_track",
      "hub_ui_progress_fill",
      "hub_ui_level_badge"
    ],
    "locationState": [
      "hub_ui_location_state_available",
      "hub_ui_location_state_locked",
      "hub_ui_location_state_active"
    ],
    "icons": [
      "hub_ui_icon_profile",
      "hub_ui_icon_character",
      "hub_ui_icon_settings",
      "hub_ui_icon_code",
      "hub_ui_icon_logout",
      "hub_ui_icon_observer",
      "hub_ui_icon_admin",
      "hub_ui_icon_notifications",
      "hub_ui_icon_blitz",
      "hub_ui_icon_duel",
      "hub_ui_icon_start_shift",
      "hub_ui_icon_inventory",
      "hub_ui_icon_tournament",
      "hub_ui_icon_archive",
      "hub_ui_icon_tasks",
      "hub_ui_notification_badge"
    ]
  },
  "semanticBindings": {
    "hub.profile": ["hub_ui_avatar_frame", "hub_ui_icon_profile"],
    "hub.settings": "hub_ui_icon_settings",
    "hub.session.character": "hub_ui_icon_character",
    "hub.session.code": "hub_ui_icon_code",
    "hub.session.admin": "hub_ui_icon_admin",
    "hub.session.logout": "hub_ui_icon_logout",
    "hub.session.observer": "hub_ui_icon_observer",
    "hub.session.notifications": ["hub_ui_icon_notifications", "hub_ui_notification_badge"],
    "hub.status.progress": ["hub_ui_progress_track", "hub_ui_progress_fill"],
    "hub.status.level": "hub_ui_level_badge",
    "hub.location.radar": "hub_ui_location_label_frame",
    "hub.location.maps-analysis": "hub_ui_location_label_frame",
    "hub.location.aerology": "hub_ui_location_label_frame",
    "hub.location.archive": "hub_ui_location_label_frame",
    "hub.location.tournament-hall": "hub_ui_location_label_frame",
    "hub.location.synoptic-center": "hub_ui_location_label_frame",
    "hub.location.state.available": "hub_ui_location_state_available",
    "hub.location.state.locked": "hub_ui_location_state_locked",
    "hub.location.state.active": "hub_ui_location_state_active",
    "hub.nav.blitz": "hub_ui_icon_blitz",
    "hub.nav.duel": "hub_ui_icon_duel",
    "hub.nav.start-shift": ["hub_ui_primary_cta_frame", "hub_ui_icon_start_shift"],
    "hub.nav.inventory": "hub_ui_icon_inventory",
    "hub.nav.tournament": "hub_ui_icon_tournament",
    "hub.nav.archive": "hub_ui_icon_archive",
    "hub.nav.tasks": "hub_ui_icon_tasks"
  },
  "responsive": {
    "coordinateModel": "normalized-anchor-plus-safe-area",
    "textAndHitAreas": "runtime-layout",
    "chromeScaling": "nine-slice-no-uniform-stretch",
    "iconScaling": "integer-or-nearest-approved-size-step",
    "breakpoints": [
      {"name":"wide","minAspect":1.55,"topStatus":"top-right","bottomNav":"bottom-center-row","locationLabels":"world-anchored"},
      {"name":"classic","minAspect":1.15,"maxAspect":1.55,"topStatus":"top-right-compact","bottomNav":"bottom-center-row","locationLabels":"world-anchored-with-collision-avoidance"},
      {"name":"portrait","maxAspect":1.15,"topStatus":"top-safe-area-compact","bottomNav":"bottom-safe-area-two-row-or-scroll","locationLabels":"world-anchored-priority-collapse"}
    ],
    "safeAreaInsets": true,
    "locationLabelPolicy": "labels follow building anchors; labels may offset to avoid overlap but never bake into background",
    "bottomNavPolicy": "nav belongs to viewport UI, not world coordinates",
    "topStatusPolicy": "status/profile belongs to viewport UI, not world coordinates"
  }
}
