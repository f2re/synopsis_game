[Unit]
Description=Synopsis Game application server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=synopsis-game
Group=synopsis-game
WorkingDirectory=/opt/synopsis-game/current/server
EnvironmentFile=-/etc/synopsis-game/app.env
Environment=SYNOPSIS_VERSION_FILE=/opt/synopsis-game/current/VERSION
ExecStart=/opt/synopsis-game/current/runtime/node/bin/node /opt/synopsis-game/current/server/server.mjs
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/synopsis-game /var/log/synopsis-game

[Install]
WantedBy=multi-user.target
