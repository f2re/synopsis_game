# Конфигурация, добавляемая при первой установке и при обновлениях.
CONFIG_SCHEMA_VERSION=1
PUBLIC_URL=http://localhost
API_BIND=127.0.0.1
API_PORT=4174
WS_PATH=/ws
WEB_SERVER=nginx
TRUSTED_LAN_CIDRS=127.0.0.1/32,::1/128
MAPS_PROVIDER=none
MAPS_BASE_URL=
MAPS_API_KEY=
KN01_TRANSPORT=file
KN01_ENDPOINT=/var/lib/synopsis-game/kn01/inbox
KN01_RULESET_ID=KN01_CURRENT_RU_2026
DATABASE_KIND=sqlite
DATABASE_URL=file:/var/lib/synopsis-game/data/synopsis.sqlite3
UPDATE_MODE=auto
UPDATE_CHANNEL=stable
UPDATE_CHECK_INTERVAL=6h
UPDATE_REPOSITORY=f2re/synopsis_game
UPDATE_ALLOW_PRERELEASE=0
BACKUP_KEEP=10
UPDATE_SOURCE=github
UPDATE_DIRECTORY=/srv/synopsis-game/releases
