{"schema_version":1,"dataset":"synopsis_pixel_prop","adapter":"props","trigger":"synopsis_pixel_prop","target_render":{"min_long_edge":1024,"scaling":"native_or_integer_nearest"},"generation_contract":{"images_per_job":1,"collage":false,"allow_flip":false,"allow_recolour_clone":false,"allow_smooth_upscale":false,"no_text":true,"one_object_per_image":true,"background":"neutral_light_gray"},"enums":{"asset_type":["physical_prop","icon","frame"],"view":["front","three_quarter","side","top"],"background":["neutral_light_gray"],"split":["train","validation"]},"style_contract":{"pixel_scale":"fixed_logical_pixel_size","presentation":"nearest_neighbour","local_surface_shades":[3,5],"margin_policy":"stable_clear_margin","forbidden":["mixed pixel scales","smooth antialiasing","painterly gradients","navy or purple studio background","collage or contact sheet","flip recolour or resize clone","readable text","named-game imitation"]},"prompt_prefix":"Standalone single pixel-art asset reference, exactly one object or one empty UI element per image. No frame around the overall image, no readable text, no logo, no collage, no contact sheet. Original 26063 cozy scientific pixel-art object language. Use one consistent logical pixel size across the entire image, hard square pixel clusters, nearest-neighbour appearance, no anti-aliasing, no smooth gradients, no mixed pixel scales and no random one-pixel noise. Keep a clean readable silhouette, stable clear margins and three to five shades per local material. Use a neutral light-gray background. Physical meteorological instruments must remain scientifically plausible and civilian. Do not imitate or name any commercial game style.","negative_prompt":"collage, contact sheet, split screen, readable text, caption, logo, dark navy studio background, purple studio background, smooth vector edge, anti-aliasing, mixed pixel sizes, blur, random one-pixel noise, painterly gradient, photorealism, 3D render, duplicated object, extra objects, military equipment, named-game imitation","subjects":{"stevenson_screen":"compact white louvred meteorological instrument shelter, scientifically plausible proportions, clean readable silhouette","cup_anemometer":"three-cup meteorological anemometer head with compact mast fitting, scientifically plausible and clearly readable","barograph":"mechanical barograph in a compact glazed or open instrument case with drum and pen arm, simplified but plausible","thermograph":"mechanical thermograph with recording drum and sensing element, simplified but plausible","hygrograph":"mechanical hygrograph with recording drum and linkage, simplified but plausible","precipitation_gauge":"standard cylindrical precipitation gauge with collector rim and support, practical meteorological field equipment","hand_compass":"compact professional hand compass for field orientation, rugged practical housing","radiosonde":"compact radiosonde package with sensors, antenna and suspension point, civilian scientific equipment","balloon_release_spool":"practical radiosonde balloon release line spool and small handling fixture","thermometer_case":"protective field thermometer case with simple latch and padded interior, compact technical object","radio_handset":"rugged portable two-way radio handset with antenna and side controls, no readable labels","technical_tablet":"compact rugged technical tablet used by a meteorological engineer, no readable interface or text","communications_headset":"lightweight technical communications headset with boom microphone, practical professional design","thermos":"compact metal thermos used during field observations, simple practical form","porcelain_mug":"plain porcelain work mug with thin blue rim, no text or logo","synoptic_pencil":"two-colour red-blue synoptic pencil, sharpened, simple readable form","clutch_pencil":"mechanical clutch pencil with brass clip, practical drafting tool","archive_binder":"thick archival meteorological binder with blank spine and worn paper edges, no readable text","observation_logbook":"hardbound observation logbook with blank cover and visible page block, no readable text","technician_canvas_bag":"weathered canvas instrument bag with flap, strap and practical compartments","trainee_backpack":"compact practical trainee backpack with simple straps and weatherproof fabric","green_desk_lamp":"classic task lamp with dark green glass shade and compact metal base","drafting_ruler":"straight drafting ruler with simple metric tick suggestion but no readable numbers or lettering","divider_compass":"metal drafting divider compass, simple technical silhouette","icon_cloud":"small pixel icon of a meteorological cloud, no text, compact readable symbol","icon_wind":"small pixel icon representing wind with simple directional airflow marks, no text","icon_thermometer":"small pixel icon of a thermometer, no text","icon_pressure":"small pixel icon representing pressure using a compact instrument-dial motif, no text","icon_archive_folder":"small pixel icon of an archive folder, no text","icon_radio":"small pixel icon of a portable radio handset, no text","icon_radar":"small pixel icon of a civilian meteorological radar dish, no text","icon_map_marker":"small pixel map-location marker icon, no text","frame_inventory_slot":"small square pixel-art inventory slot frame, empty center, no text","frame_portrait":"small rectangular pixel-art portrait frame, empty center, no text","frame_tooltip":"compact pixel-art tooltip frame with empty interior, no text","frame_status_badge":"small compact pixel-art status badge frame with empty center, no text"},"samples":[{"id":"prop-stevenson-screen-01","subject_id":"stevenson_screen","asset_type":"physical_prop","lineage_id":"prop-src-001","split":"train","view":"three_quarter","background":"neutral_light_gray","independent_render":true,"num_images":1,"min_long_edge":1024,"output_path":"datasets/lora/props/source/prop-stevenson-screen-01.png"},{"id":"prop-cup-anemometer-01","subject_id":"