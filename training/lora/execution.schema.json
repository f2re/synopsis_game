{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/f2re/synopsis_game/training/lora/execution.schema.json",
  "title": "26063 LoRA generation execution ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset",
    "adapter",
    "trigger",
    "source_manifest",
    "manifest_sha256",
    "queue_builder",
    "queue_builder_sha256",
    "jobs"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "dataset": {"type": "string", "minLength": 1},
    "adapter": {"type": "string", "minLength": 1},
    "trigger": {"type": "string", "minLength": 1},
    "source_manifest": {"type": "string", "minLength": 1},
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "queue_builder": {"type": "string", "minLength": 1},
    "queue_builder_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "jobs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["job_id", "base_lineage_id", "split", "planned_output_path", "seed", "status", "attempts"],
        "properties": {
          "job_id": {"type": "string", "minLength": 1},
          "base_lineage_id": {"type": "string", "minLength": 1},
          "split": {"enum": ["train", "validation"]},
          "planned_output_path": {"type": "string", "minLength": 1},
          "seed": {"type": "integer", "minimum": 0},
          "status": {"enum": ["pending", "candidate", "rejected", "pixel_accepted", "art_accepted", "accepted"]},
          "attempts": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "attempt_id",
                "lineage_id",
                "output_path",
                "seed",
                "prompt_sha256",
                "negative_prompt_sha256",
                "state",
                "generator",
                "sha256",
                "generated_at",
                "gates",
                "reject_reasons"
              ],
              "properties": {
                "attempt_id": {"type": "integer", "minimum": 1},
                "lineage_id": {"type": "string", "minLength": 1},
                "output_path": {"type": "string", "minLength": 1},
                "seed": {"type": "integer", "minimum": 0},
                "prompt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "negative_prompt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "state": {"enum": ["candidate", "rejected", "accepted"]},
                "generator": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["provider", "model", "version"],
                  "properties": {
                    "provider": {"type": "string", "minLength": 1},
                    "model": {"type": "string", "minLength": 1},
                    "version": {"type": "string", "minLength": 1}
                  }
                },
                "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
                "generated_at": {"type": ["string", "null"], "format": "date-time"},
                "gates": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["pixel_art", "art_direction", "integration"],
                  "properties": {
                    "pixel_art": {"enum": ["pending", "accepted", "rejected"]},
                    "art_direction": {"enum": ["pending", "accepted", "rejected"]},
                    "integration": {"enum": ["pending", "accepted", "rejected"]}
                  }
                },
                "reject_reasons": {"type": "array", "items": {"type": "string", "minLength": 1}}
              }
            }
          }
        }
      }
    }
  }
}
