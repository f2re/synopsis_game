{
  "name": "synopsis-game",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.34.8",
  "workspaces": ["apps/*", "packages/*", "tools/*"],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "bootstrap:web": "pnpm -C apps/web install --ignore-workspace --no-frozen-lockfile",
    "dev": "pnpm -C apps/web dev",
    "build": "pnpm -C apps/web build",
    "typecheck": "pnpm -C apps/web typecheck",
    "assets:toolchain:check": "pnpm --filter @synopsis/assets-pipeline toolchain:check",
    "world:typecheck": "pnpm --filter @synopsis/world-engine typecheck"
  }
}
