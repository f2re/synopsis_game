{
  "name": "@synopsis/contracts",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./level": {
      "types": "./dist/level.d.ts",
      "import": "./dist/level.js"
    },
    "./progression": {
      "types": "./dist/progression.d.ts",
      "import": "./dist/progression.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
